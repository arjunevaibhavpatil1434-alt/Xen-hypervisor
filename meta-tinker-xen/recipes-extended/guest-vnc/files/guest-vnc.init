#!/bin/sh
### BEGIN INIT INFO
# Provides:          guest-vnc
# Required-Start:    xen-guests
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Show a Xen guest PV screen on the HDMI monitor (touch/mouse/keys)
### END INIT INFO
#
# Runs guest-vnc when dom0 has a framebuffer (HDMI). It waits for the
# guest's VNC server (QEMU, 127.0.0.1:5900) and reconnects when the guest
# restarts. Off by default, like the experimental PV screen it shows (vfb in
# a Xen guest configuration): enable with ENABLED=1 in /etc/default/guest-vnc.

ENABLED=0
FBDEV=/dev/fb0
PIDFILE=/var/run/guest-vnc.pid
LOG=/var/log/guest-vnc.log
[ -r /etc/default/guest-vnc ] && . /etc/default/guest-vnc

case "$1" in
start)
    [ "$ENABLED" = 1 ] || exit 0
    # $FBDEV appears once a monitor is connected (the HDMI driver creates
    # it on the first hotplug), so wait for it in the background
    echo "Starting guest-vnc (waits for $FBDEV, i.e. an HDMI monitor)"
    ( while [ ! -c $FBDEV ]; do sleep 2; done
      while :; do guest-vnc -f $FBDEV; sleep 2; done ) >>$LOG 2>&1 </dev/null &
    echo $! > $PIDFILE
    ;;
stop)
    if [ -f $PIDFILE ]; then
        kill "$(cat $PIDFILE)" 2>/dev/null
        killall guest-vnc 2>/dev/null
        rm -f $PIDFILE
    fi
    ;;
restart)
    $0 stop; $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
