#!/bin/sh
### BEGIN INIT INFO
# Provides:          audio-mixer
# Required-Start:    networking usb-attach
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Audio pipeline: chimes and video sound to the speaker
### END INIT INFO
#
# audio-mixer mixes the vehicle chimes (highest priority, the video sound is
# turned down while one plays) and the video sound (UDP 5601 on 127.0.0.1)
# into the speaker output. Chimes: dom0's media-link (UDP CHIME_PORT, the
# FreeRTOS warnings) and rear-camera (the reverse beep).
# Settings: /etc/default/audio-mixer. Test: "audio-mixer -c warn".

ENABLED=1
DEVICE=plughw:CARD=Audio,DEV=1
GAIN=100
VOLUME=100
CONTROL="PCM,1"
CHIME_PORT=5604
DOM0=192.168.100.1
OPTS=""
PIDFILE=/var/run/audio-mixer.pid
VOLPID=/var/run/audio-mixer-volume.pid
LOG=/var/log/audio-mixer.log
[ -r /etc/default/audio-mixer ] && . /etc/default/audio-mixer

case "$1" in
start)
    [ "$ENABLED" = 1 ] || exit 0
    echo "Starting audio-mixer on $DEVICE"
    ( while :; do
          audio-mixer -D "$DEVICE" -g "$GAIN" -C "$CHIME_PORT" -R "$DOM0" $OPTS
          sleep 2
      done ) >>$LOG 2>&1 </dev/null &
    echo $! > $PIDFILE
    # Unmute and set the volume each time the codec appears: over USB/IP it
    # comes after usb-attach (usually after audio-mixer), and again after a
    # reconnect, with the codec's power-on mixer state.
    card=$(echo "$DEVICE" | sed -n 's/.*CARD=\([^,]*\).*/\1/p')
    if [ -n "$card" ]; then
        ( was=0
          while :; do
              if [ -e /proc/asound/$card ]; then
                  if [ $was = 0 ]; then
                      sleep 1
                      if amixer -q -c "$card" sset "$CONTROL" "$VOLUME%" unmute; then
                          echo "audio-mixer: $card $CONTROL set to $VOLUME%, unmuted"
                      else
                          echo "audio-mixer: amixer -c $card sset $CONTROL failed"
                      fi
                  fi
                  was=1
              else
                  was=0
              fi
              sleep 2
          done ) >>$LOG 2>&1 </dev/null &
        echo $! > $VOLPID
    fi
    ;;
stop)
    for p in $PIDFILE $VOLPID; do
        [ -f $p ] && kill "$(cat $p)" 2>/dev/null
        rm -f $p
    done
    # not "killall audio-mixer": this script has that name too
    for p in $(pidof audio-mixer); do [ "$p" = $$ ] || kill $p; done
    ;;
restart)
    $0 stop; $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
