#!/bin/sh
### BEGIN INIT INFO
# Provides:          rear-camera
# Required-Start:    networking usb-attach audio-mixer
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Rear camera on media1's screen while in reverse
### END INIT INFO
#
# In reverse (gear frames from dom0's media-link) rear-camera pauses the
# video (media-ctl), shows the camera on media1's screen and asks
# audio-mixer for the reverse chime; afterwards the video carries on.
# Settings: /etc/default/rear-camera. Log: /var/log/rear-camera.log.
# Test: /etc/init.d/vehicle-bench reverse in dom0.

ENABLED=1
FBDEV=/dev/fb0
CAMERA=/dev/video0
GEAR_PORT=5603
DOM0=192.168.100.1
PAUSE=127.0.0.1:5602
OPTS=""
PIDFILE=/var/run/rear-camera.pid
LOG=/var/log/rear-camera.log
[ -r /etc/default/rear-camera ] && . /etc/default/rear-camera

case "$1" in
start)
    [ "$ENABLED" = 1 ] || exit 0
    echo "Starting rear-camera on $FBDEV"
    ( while [ ! -c $FBDEV ]; do sleep 2; done
      while :; do
          rear-camera -f $FBDEV -d $CAMERA -u $GEAR_PORT -G $DOM0 -p $PAUSE -S $OPTS
          sleep 2
      done ) >>$LOG 2>&1 </dev/null &
    echo $! > $PIDFILE
    ;;
stop)
    [ -f $PIDFILE ] && kill "$(cat $PIDFILE)" 2>/dev/null
    rm -f $PIDFILE
    # not "killall rear-camera": this script has that name too
    for p in $(pidof rear-camera); do [ "$p" = $$ ] || kill $p; done
    ;;
restart)
    $0 stop; $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
