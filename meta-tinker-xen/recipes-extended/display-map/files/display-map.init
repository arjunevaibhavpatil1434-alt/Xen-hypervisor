#!/bin/sh
### BEGIN INIT INFO
# Provides:          display-map
# Required-Start:    xen-guests vehicle-bench
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: One screen per OS: guests, cluster and dom0 console on HDMI + USB displays
### END INIT INFO
#
# Starts one viewer per screen listed in SCREENS (/etc/default/display-map):
# guest-vnc for a guest's PV framebuffer, cluster-hdmi for the instrument
# cluster, con2fb for dom0's text console; rear-camera around a viewer (it
# pauses the viewer and shows the camera in reverse). Each screen waits for its display
# (HDMI creates its framebuffer on the first hotplug, USB adapters when they
# are plugged in) and is picked up again after an unplug.

SCREENS="hdmi=vnc:5901"
SCALE=fill
IFACE=vcan0
PIDDIR=/var/run/display-map
LOG=/var/log/display-map.log
[ -r /etc/default/vehicle-bench ] && . /etc/default/vehicle-bench
[ -r /etc/default/display-map ] && . /etc/default/display-map

# /dev/fbN of a screen name, empty if it is not connected
screen_fb() {
    case "$1" in
    hdmi)
        for f in /sys/class/graphics/fb*; do
            grep -qs rockchip $f/name && { echo /dev/${f##*/}; return; }
        done
        ;;
    usb*)
        # USB adapters in USB port order
        for f in /sys/class/graphics/fb*; do
            grep -qs udl $f/name && echo "$(readlink -f $f/device) ${f##*/}"
        done | sort | sed -n "${1#usb}p" | sed 's,.* ,/dev/,'
        ;;
    esac
}

# Is the guest behind VNC port $1 showing its own screen yet? Until its
# kernel connects its PV framebuffer, QEMU serves a placeholder ("This VM has
# no graphic display device"), which must not reach the monitor. Connected:
# the vfb backend with vncdisplay=<port - 5900> and its frontend are in
# state 4.
guest_fb_ready() {
    want=$(($1 - 5900))
    for d in $(xenstore-list /local/domain/0/backend/vfb 2>/dev/null); do
        b=/local/domain/0/backend/vfb/$d/0
        [ "$(xenstore-read $b/vncdisplay 2>/dev/null)" = "$want" ] || continue
        [ "$(xenstore-read $b/state 2>/dev/null)" = 4 ] || continue
        # and the guest side too: the backend entry of a guest that has
        # just been destroyed can still read 4 for a moment
        fe=$(xenstore-read $b/frontend 2>/dev/null)
        [ -n "$fe" ] && [ "$(xenstore-read $fe/state 2>/dev/null)" = 4 ] && return 0
    done
    return 1
}

# Keep one screen's viewer running (in the background)
run_screen() {
    screen=$1 source=$2
    eval input=\${INPUT_$screen:-none}
    eval scale=\${SCALE_$screen:-$SCALE}
    eval pause=\${PAUSE_$screen:-}
    while :; do
        fb=$(screen_fb $screen)
        if [ -z "$fb" ] || [ ! -c "$fb" ]; then
            sleep 2
            continue
        fi
        case "$source" in
        *vnc:*)
            # not before the guest's own screen is there
            port=${source##*:} n=0
            until guest_fb_ready $port; do
                [ $n = 0 ] && echo "$screen: waiting for the guest screen on VNC port $port"
                n=1; sleep 1
            done
            ;;
        esac
        echo "$screen ($fb): $source"
        # guest-vnc -1 exits when the guest goes away (restart, crash): the
        # loop then waits for its screen again rather than showing QEMU's
        # placeholder ("This VM has no graphic display device") meanwhile
        case "$source" in
        vnc:*)   guest-vnc -1 -f $fb -p ${source#vnc:} -I "$input" -m $scale ;;
        cluster) cluster-hdmi -f $fb -i $IFACE ;;
        rearcam:vnc:*)
            rear-camera -f $fb -i $IFACE ${pause:+-p $pause} -- guest-vnc -1 -f $fb -p ${source#rearcam:vnc:} -I "$input" -m $scale ;;
        rearcam:cluster)
            rear-camera -f $fb -i $IFACE ${pause:+-p $pause} -- cluster-hdmi -f $fb -i $IFACE ;;
        rearcam) rear-camera -f $fb -i $IFACE ${pause:+-p $pause} ;;
        console)
            con2fb $fb 1
            # until the display goes away
            while [ -c $fb ] && [ "$(screen_fb $screen)" = $fb ]; do sleep 2; done
            ;;
        *)       echo "$screen: unknown source $source"; return 1 ;;
        esac
        sleep 2
    done
}

case "$1" in
start)
    mkdir -p $PIDDIR
    for entry in $SCREENS; do
        screen=${entry%%=*}
        echo "Starting display-map: $entry"
        run_screen $screen ${entry#*=} >>$LOG 2>&1 </dev/null &
        echo $! > $PIDDIR/$screen.pid
    done
    ;;
stop)
    for p in $PIDDIR/*.pid; do
        [ -f "$p" ] && kill "$(cat $p)" 2>/dev/null
        rm -f "$p"
    done
    # rear-camera first: it lets a viewer it has paused finish too
    killall rear-camera 2>/dev/null
    killall guest-vnc cluster-hdmi 2>/dev/null
    ;;
restart)
    $0 stop; $0 start
    ;;
*)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
