#!/bin/sh
# vehicle-chimes: the FreeRTOS guest's vehicle warnings as chimes.
#
# Follows rtos1's console log (written by xenconsoled, as for cluster-hdmi)
# and asks for a warning chime when the real-time vehicle task raises an
# alert (overspeed, redline, signal lost) and a softer one when it clears.
# media-link sends the request to media1's audio-mixer, which plays it.
# The reverse chime comes from media1's rear-camera.
#
#   vehicle-chimes [rtos console log]

LOG=${1:-/var/log/xen/console/guest-rtos1.log}

# -F: keeps following when the log is created later or trimmed
tail -n 0 -F "$LOG" 2>/dev/null | while read -r line; do
    case "$line" in
    *"ALERT "*|*"SIGNAL LOST"*)        media-link -s warn ;;
    *" cleared"*|*"SIGNAL OK again"*)  media-link -s info ;;
    esac
done
